---
import { localModel } from '../../scripts/robot/model';
import RobotConversation from './RobotConversation.astro';
---

<RobotConversation>
  <Fragment slot="consent">
    <section
      data-ai-consent
      class="robot-start"
      aria-label="Start local conversation">
      <button type="button" data-explore
        >Explore experience · no download</button
      >
      <p>
        Optional chat uses {localModel.name}: {localModel.download} to download and
        {localModel.memory}. Desktop recommended. Requires shader-f16; mobile
        chat is untested.
      </p>
      <button type="button" data-enable
        >Download and start chat · {localModel.download}</button
      >
      <small data-model-notice
        >Desktop recommended · {localModel.memory} · mobile chat untested.</small
      >
      <small
        >Model hosts receive downloads, never questions. Files may stay cached.
        The GPU check cannot measure free memory.</small
      >
    </section>
  </Fragment>
  <Fragment slot="about">
    <details class="robot-about">
      <summary>About this conversation</summary>
      <p>
        This chat uses the same experience records as the TimsExperiments MCP.
        <a href="/resume/mcp" target="_blank" rel="noopener noreferrer"
          >Follow the guide</a
        >
        to use it in your own agents.
      </p>
      <p>
        AI-written answers can be wrong. Replies run in your browser, and
        completed chats are saved for Tim to read. Closing or clearing removes
        your local copy.
      </p>
    </details>
  </Fragment>
</RobotConversation>

<script>
  import '../../scripts/robot/host';
</script>
