<dialog
  id="reader-dialog"
  class="lab-dialog tablet-reader"
  aria-label="Recipe tablet">
  <div class="tablet-hardware" aria-hidden="true">
    <span></span>LAB / READER
  </div>
  <div class="tablet-screen">
    <div class="tablet-toolbar">
      <button id="reader-back" type="button">← Shelf</button>
      <span class="tablet-label">RECIPE TABLET</span>
      <button
        class="dialog-close"
        type="button"
        aria-label="Return tablet to the room"
        >Return <span aria-hidden="true">↘</span></button
      >
    </div>
    <div class="reader-navigation">
      <label for="reader-contents">Jump to</label>
      <select id="reader-contents" disabled aria-controls="reader-content"
        ><option>Article start</option></select
      >
      <a id="reader-standalone" href="/lab" target="_blank" rel="noopener"
        >Standalone ↗<span class="sr-only"> (opens in a new tab)</span></a
      >
    </div>
    <p
      id="reader-status"
      class="reader-status"
      role="status"
      aria-live="polite">
    </p>
    <div
      id="reader-viewport"
      class="reader-viewport"
      tabindex="0"
      aria-label="Article, scroll to read">
      <div id="reader-error" class="reader-error" hidden>
        <h2>Couldn't load this recipe.</h2><p>
          Check your connection and try again, or use the standalone article
          link above.
        </p><button id="reader-retry" class="mint-button" type="button"
          >Try again</button>
      </div>
      <div id="reader-content" aria-busy="false"></div>
    </div>
    <div class="reader-footer" aria-label="Article navigation">
      <button id="reader-previous" type="button" disabled>↑ Previous</button>
      <span id="reader-position">Article start</span>
      <button id="reader-next" type="button" disabled>Next ↓</button>
    </div>
  </div>
  <div class="tablet-grip" aria-hidden="true"></div>
</dialog>
