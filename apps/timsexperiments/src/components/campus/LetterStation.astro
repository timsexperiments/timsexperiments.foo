  @media (max-height: 500px) and (min-width: 701px) {
    .little-mailbox {
      display: none;
    }
    .letter-intro h2 {
      font-size: 32px;
    }
    .letter-paper {
      padding: 16px 22px;
    }
    .letter-paper textarea {
      min-height: 90px;
    }
    .paper-dear {
      margin: 8px 0;
    }
    .letter-address {
      margin: 16px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .letter-paper.accepted {
      animation: none;
    }
  }
</style>
<script src="@/scripts/site/letter-station.ts"></script>
