<section class="letter-station" aria-labelledby="contact-title">
  <div class="letter-intro"><h2 id="contact-title">Something on<br /> <em>your mind?</em></h2><p>A project, a tricky software problem, or an idea worth exploring. Write me a note.</p><div class="letter-address"><span>DELIVER TO</span><strong>Tim Altemus</strong><a href="mailto:hello@timsexperiments.foo">hello@timsexperiments.foo ↗</a></div><div class="little-mailbox" aria-hidden="true"><span>LETTERS & GOOD IDEAS</span><div class="mailbox-slot"></div><div class="paper-envelope"></div></div><p class="delivery-note" id="delivery-note">Your letter goes straight to Tim. Your email is used only so he can reply.</p></div>
  <form id="letter-form" class="letter-paper">
    <div class="paper-heading"><span>TIM'S EXPERIMENTS<br />PERSONAL CORRESPONDENCE</span><span class="paper-stamp" aria-hidden="true"><img src="/favicon.svg" width="36" height="37" alt="" /></span></div>
    <p class="paper-dear">Hey Tim,</p>
    <label class="letter-message-label" for="letter-message">Your message</label><textarea id="letter-message" name="message" required minlength="10" maxlength="6000" placeholder="I've been thinking about…" rows="7"></textarea>
    <div class="letter-signature"><label for="letter-name">From</label><input id="letter-name" name="name" autocomplete="name" required maxlength="100" placeholder="Your name" /><label for="letter-email">Reply to</label><input id="letter-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></div>
    <div class="letter-trap" aria-hidden="true"><label for="letter-website">Leave this empty</label><input id="letter-website" name="website" tabindex="-1" autocomplete="off" /></div>
    <div class="letter-actions"><button type="submit" id="letter-send">Send <span aria-hidden="true">↗</span></button><button type="button" id="letter-copy">Copy letter</button></div>
    <p id="letter-status" role="status"></p>
  </form>
</section>
<style>
.letter-station{display:grid;grid-template-columns:.75fr 1.25fr;gap:45px;padding-top:5px}.letter-intro h2{font-family:Urbanist,Inter,'Lab Sans',sans-serif;font-size:43px;line-height:1.1;letter-spacing:-.04em;font-weight:400;margin:0 0 22px}.letter-intro h2 em{font-style:normal;color:#54d4b7}.letter-intro>p{font-size:12px;line-height:1.85;color:#a7b9ad}.letter-address{display:flex;flex-direction:column;gap:10px;margin:30px 0}.letter-address>span{font-size:8px;color:#809e8d;letter-spacing:.18em}.letter-address strong{font-size:15px;font-weight:400}.letter-address a{font-size:11px;color:#77cfb1}.letter-paper{background:#eee9d8;color:#354237;padding:26px 30px 20px;box-shadow:3px 5px 0 #c7c6b4;border-radius:1px;transform:rotate(.5deg);position:relative;transition:transform .6s,opacity .6s}.paper-heading{display:flex;justify-content:space-between;gap:20px;color:#6b7866;font-family:monospace;font-size:7px;letter-spacing:.1em;line-height:1.6}.paper-stamp{border:2px dotted #71866e;padding:7px 8px;display:grid;place-items:center;flex:none;color-scheme:light}.paper-stamp img{display:block;width:36px;height:auto}.paper-dear{font-family:Georgia,serif;font-style:italic;font-size:21px;margin:25px 0 15px}.letter-paper textarea{display:block;width:100%;background:repeating-linear-gradient(transparent,transparent 30px,#b7c0a660 30px,#b7c0a660 31px);border:0;resize:vertical;min-height:200px;line-height:31px;font-family:Georgia,serif!important;font-size:17px!important;color:#354237;padding:0;outline-offset:6px}.letter-paper textarea::placeholder{color:#596650}.letter-signature{display:grid;grid-template-columns:55px 1fr;align-items:center;gap:10px;margin:22px 0}.letter-message-label{display:block;margin:0 0 6px;font-family:Georgia,serif;font-size:12px;font-style:italic;color:#596650}.letter-signature label{font-family:Georgia,serif;font-size:12px;font-style:italic;color:#596650}.letter-signature input{min-width:0;background:none;border:0;border-bottom:1px solid #b5bda4;color:#354237;border-radius:0;padding:8px 4px;font-size:12px}.letter-signature input::placeholder{color:#596650}.letter-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:15px;border-top:1px solid #b7c0a6}.letter-actions button[type=submit]{background:#164c3b;border:1px solid #164c3b;border-radius:2px;padding:12px 17px;color:#f0f2df;font-size:11px;display:flex;gap:20px}.letter-actions button[type=button]{border:0;background:none;color:#52634f;font-size:10px;text-decoration:underline;text-underline-offset:3px}#letter-status{font-size:11px;line-height:1.6;margin:12px 0 0;min-height:17px}.letter-paper.sending{transform:translateY(-15px) rotate(-2deg);opacity:.5}.letter-paper.accepted{animation:letter-posted .8s ease}.letter-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.little-mailbox{margin-top:28px;background:linear-gradient(135deg,#2a5a43,#193c2d);border:1px solid #52775c;border-radius:8px 8px 3px 3px;height:125px;position:relative;padding:27px 20px;box-shadow:0 12px 30px #0004}.little-mailbox>span{display:block;text-align:center;font-size:7px;letter-spacing:.2em;color:#b8cab5}.mailbox-slot{height:9px;background:#07140d;margin-top:18px;border-bottom:2px solid #65806b;border-radius:3px;box-shadow:inset 0 3px 3px #000}.paper-envelope{position:absolute;left:50%;bottom:10px;width:45px;height:27px;background:#cfceb6;transform:translateX(-50%) rotate(-5deg);clip-path:polygon(0 0,50% 35%,100% 0,100% 100%,0 100%);opacity:.5}.delivery-note{font-size:10px!important;color:#8aa692!important;margin-top:20px}.letter-station :focus-visible{outline-color:#08795b}.letter-intro :focus-visible{outline-color:#5cebce}@keyframes letter-posted{0%{transform:rotate(.5deg)}45%{transform:scale(.65) rotate(-5deg);opacity:.2}100%{transform:rotate(.5deg);opacity:1}}@media(max-width:700px){.letter-station{grid-template-columns:1fr;gap:25px}.letter-intro h2{font-size:34px}.letter-intro h2 br{display:none}.letter-intro p{margin-bottom:0}.letter-address{margin:16px 0;gap:6px}.little-mailbox{display:none}.letter-paper{padding:22px}.letter-intro>p.delivery-note{margin-top:12px}.letter-paper textarea{font-size:16px!important}}
</style>
<script src="@/scripts/site/letter-station.ts"></script>
