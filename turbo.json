{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_AUTH_TOKEN",
        "PUBLIC_*",
        "ASTRO_STUDIO_APP_TOKEN"
      ]
    },
    "check": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
